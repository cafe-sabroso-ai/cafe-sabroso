FROM python:3.12-slim
WORKDIR /app
RUN printf '%s' '' >> /tmp/arena.b64
RUN printf '%s' '' >> /tmp/arena.b64
RUN printf '%s' '' >> /tmp/arena.b64
RUN printf '%s' '' >> /tmp/arena.b64
RUN python -c "import base64,io,zipfile; zipfile.ZipFile(io.BytesIO(base64.b64decode(open('/tmp/arena.b64').read()))).extractall('/app')" && pip install --no-cache-dir -r requirements.txt && useradd -m arena && rm /tmp/arena.b64
USER arena
CMD ["sh","-c","uvicorn preview_app:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --no-proxy-headers"]
